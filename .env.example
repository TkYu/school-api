# Copy to .env on the server (never commit .env). Values here are names and defaults only.
# compose sets DATABASE_URL and DATABASE_PASSWORD_FILE (secrets/db_password) itself.

# Bearer token for the admin's own scripts and crawlers (ingest API): a long random string. What they submit belongs
# to the admin. People log in with accounts made in the web UI (/admin/signup); the first confirmed one is the admin.
INGEST_TOKEN=
# Signs the session cookie: a long random string
SESSION_SECRET=
# Where uploaded / crawled original files are kept (inside the container)
FILES_DIR=/data/files

# The address people open, for links in mails (https://…, no trailing slash)
PUBLIC_URL=
# Who may sign up: comma-separated domains (@example.ac.jp) and / or full addresses.
# Empty = nobody, except the very first account (which becomes the admin).
SIGNUP_ALLOWLIST=
# true: a submitter's upload is published at once. Empty or false: it waits for the admin's review.
DIRECT_PUBLISH=

# Mail (sign-up confirmation, password reset, review notices); the worker sends it
SMTP_HOST=
SMTP_PORT=587
# starttls (usually port 587), ssl (port 465) or none
SMTP_SECURITY=starttls
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Web uploads: MB per file and per upload (behind Cloudflare's free plan a request may be at most 100 MB: use 95)
UPLOAD_MAX_FILE_MB=50
UPLOAD_MAX_TOTAL_MB=200

# Compose (read by docker compose from this file too)
# which compose file when not compose.yml (CPU): compose.gpu.yml (NVIDIA GPU) or your own compose.local.yml
# (leave the line commented out for compose.yml: an empty value is an error)
# COMPOSE_FILE=compose.gpu.yml
# the port on 127.0.0.1 the API is published on, for the reverse proxy
API_PORT=8000
